{
  "name": "paseboon-js",
  "productName": "Paseboon JS",
  "version": "0.1.3",
  "description": "Locks your computer when you walk away, and when someone else sits down.",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aliy0219/paseboon-js.git"
  },
  "type": "module",
  "main": "src/main/main.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test test/",
    "models": "node scripts/fetch-models.mjs",
    "dist:mac": "npm run models && electron-builder --mac",
    "dist:win": "npm run models && electron-builder --win",
    "dist:linux": "npm run models && electron-builder --linux"
  },
  "dependencies": {
    "koffi": "3.3.4",
    "onnxruntime-node": "1.31.1"
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "26.18.0"
  },
